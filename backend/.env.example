# SchemaSense Environment Variables
DEBUG=True
HOST=0.0.0.0
PORT=8000

# App Database URL (Postgres with pgvector or SQLite)
DATABASE_URL=sqlite:///./schemasense_app.db

# Redis Cache URL
REDIS_URL=redis://localhost:6379/0

# Master Encryption Key for Credential Envelope Encryption (32-bytes)
MASTER_ENCRYPTION_KEY=schemasense-master-secret-key-32b-min!!

# LLM Provider: "lmstudio", "openai", "gemini", "mock"
LLM_PROVIDER=mock
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=lm-studio
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Leave LLM_MODEL empty for LM Studio to auto-select the currently loaded model
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
